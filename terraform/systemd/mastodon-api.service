[Unit]
Description=Mastodon API
Documentation=https://redplanetlabs.com/docs/~/operating-rama.html
# API requires the Rama cluster to be fully up before starting
After=network.target rama-supervisor.service
Requires=rama-supervisor.service

[Service]
Type=simple
User=root
Group=root

Environment="JAVA_HOME=/usr/lib/jvm/java-1.8.0-amazon-corretto"
Environment="PATH=/usr/lib/jvm/java-1.8.0-amazon-corretto/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

WorkingDirectory=/opt/mastodon-api

ExecStart=/usr/lib/jvm/java-1.8.0-amazon-corretto/bin/java -jar /opt/mastodon-api/mastodonapi.jar 127.0.0.1

StandardOutput=append:/opt/mastodon-api/logs/api-stdout.log
StandardError=append:/opt/mastodon-api/logs/api-stderr.log

Restart=on-failure
# Use a long restart delay so that on fresh bootstrap the API doesn't
# hammer the conductor in a tight loop while modules are still deploying.
# Once modules are RUNNING the API will come up on the next retry.
RestartSec=60
StartLimitIntervalSec=3600
StartLimitBurst=20
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
